{
  "name": "quake-sim-desktop",
  "productName": "Quake Simulator",
  "version": "1.1.0",
  "description": "Japan earthquake and Earthquake Early Warning simulator (desktop app)",
  "main": "main.js",
  "author": "malik05051",
  "license": "MPL-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.malik05051.quakesim",
    "productName": "Quake Simulator",
    "files": [
      "main.js",
      "src/**/*",
      "node_modules/maplibre-gl/dist/**/*",
      "LICENSE"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Science",
      "icon": "build/icon.png",
      "artifactName": "QuakeSimulator-${version}-${arch}.AppImage"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "QuakeSimulator-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "QuakeSimulator-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
